{
  "schemaVersion": 1,
  "project": "win-glaze-dots",
  "runtime": {
    "stableTagPattern": "^v\\d+\\.\\d+\\.\\d+$",
    "repository": "dillacorn/win-glaze-dots"
  },
  "profiles": {
    "normal": {
      "label": "Normal / personal PC",
      "defaultGlazeWM": "normal"
    },
    "work": {
      "label": "Work PC",
      "defaultGlazeWM": "work"
    }
  },
  "components": [
    {
      "id": "glazewm",
      "name": "GlazeWM",
      "defaultNormal": true,
      "defaultWork": true,
      "files": [
        {
          "id": "glazewm-config",
          "sourceByGlazeProfile": {
            "normal": "UserProfile/.glzr/glazewm/config.yaml",
            "work": "UserProfile/.glzr/glazewm/custom_work_config.yaml"
          },
          "destination": "%USERPROFILE%\\.glzr\\glazewm\\config.yaml",
          "merge": true
        }
      ]
    },
    {
      "id": "yasb",
      "name": "YASB",
      "defaultNormal": true,
      "defaultWork": true,
      "files": [
        {
          "id": "yasb-config",
          "source": "UserProfile/.config/yasb/config.yaml",
          "destination": "%USERPROFILE%\\.config\\yasb\\config.yaml",
          "merge": true
        },
        {
          "id": "yasb-styles",
          "source": "UserProfile/.config/yasb/styles.css",
          "destination": "%USERPROFILE%\\.config\\yasb\\styles.css",
          "merge": true
        },
        {
          "id": "yasb-readme",
          "source": "UserProfile/.config/yasb/README.md",
          "destination": "%USERPROFILE%\\.config\\yasb\\README.md",
          "merge": false
        }
      ],
      "postActions": [
        {
          "type": "ensure-yasb-theme"
        }
      ]
    },
    {
      "id": "cursor",
      "name": "Cursor theme",
      "defaultNormal": true,
      "defaultWork": true,
      "files": [],
      "postActions": [
        {
          "type": "ensure-cursor-theme"
        }
      ]
    },
    {
      "id": "yazi",
      "name": "Yazi",
      "defaultNormal": true,
      "defaultWork": true,
      "files": [
        {
          "id": "yazi-keymap",
          "source": "UserProfile/AppData/Roaming/yazi/config/keymap.toml",
          "destination": "%APPDATA%\\yazi\\config\\keymap.toml",
          "merge": true
        },
        {
          "id": "yazi-package",
          "source": "UserProfile/AppData/Roaming/yazi/config/package.toml",
          "destination": "%APPDATA%\\yazi\\config\\package.toml",
          "merge": true
        },
        {
          "id": "yazi-config",
          "source": "UserProfile/AppData/Roaming/yazi/config/yazi.toml",
          "destination": "%APPDATA%\\yazi\\config\\yazi.toml",
          "merge": true
        },
        {
          "id": "yazi-system-clipboard",
          "source": "UserProfile/AppData/Roaming/yazi/config/plugins/system-clipboard.yazi/main.lua",
          "destination": "%APPDATA%\\yazi\\config\\plugins\\system-clipboard.yazi\\main.lua",
          "merge": true
        }
      ],
      "postActions": [
        {
          "type": "set-yazi-file-one"
        },
        {
          "type": "yazi-package-install"
        }
      ]
    },
    {
      "id": "terminal",
      "name": "Windows Terminal",
      "defaultNormal": true,
      "defaultWork": true,
      "files": [
        {
          "id": "terminal-settings",
          "source": "UserProfile/AppData/Local/Packages/Microsoft.WindowsTerminal_8wekyb3d8bbwe/LocalState/settings.json",
          "destination": "%LOCALAPPDATA%\\Packages\\Microsoft.WindowsTerminal_8wekyb3d8bbwe\\LocalState\\settings.json",
          "merge": true,
          "validator": "json"
        }
      ]
    },
    {
      "id": "altsnap",
      "name": "AltSnap",
      "defaultNormal": true,
      "defaultWork": true,
      "files": [
        {
          "id": "altsnap-config",
          "source": "UserProfile/AppData/Roaming/AltSnap/AltSnap.ini",
          "destination": "%APPDATA%\\AltSnap\\AltSnap.ini",
          "merge": true
        }
      ]
    },
    {
      "id": "flameshot",
      "name": "Flameshot",
      "defaultNormal": true,
      "defaultWork": true,
      "files": [
        {
          "id": "flameshot-config",
          "source": "UserProfile/AppData/Roaming/flameshot/flameshot.ini",
          "destination": "%APPDATA%\\flameshot\\flameshot.ini",
          "merge": true
        }
      ]
    },
    {
      "id": "btop",
      "name": "btop",
      "defaultNormal": true,
      "defaultWork": false,
      "files": [
        {
          "id": "btop-config",
          "source": "UserProfile/.config/btop/btop.conf",
          "destination": "%USERPROFILE%\\.config\\btop\\btop.conf",
          "merge": true
        }
      ]
    },
    {
      "id": "scripts",
      "name": "User scripts",
      "defaultNormal": true,
      "defaultWork": false,
      "files": [
        {
          "id": "script-1024x768",
          "source": "UserProfile/scripts/1024x768_stretched_res.bat",
          "destination": "%USERPROFILE%\\scripts\\1024x768_stretched_res.bat",
          "merge": false
        },
        {
          "id": "script-1280x960",
          "source": "UserProfile/scripts/1280x960_stretched_res.bat",
          "destination": "%USERPROFILE%\\scripts\\1280x960_stretched_res.bat",
          "merge": false
        },
        {
          "id": "script-16-10",
          "source": "UserProfile/scripts/16.10_stretched_res.bat",
          "destination": "%USERPROFILE%\\scripts\\16.10_stretched_res.bat",
          "merge": false
        },
        {
          "id": "script-16-9",
          "source": "UserProfile/scripts/16.9_native_res.bat",
          "destination": "%USERPROFILE%\\scripts\\16.9_native_res.bat",
          "merge": false
        },
        {
          "id": "script-1680x1050",
          "source": "UserProfile/scripts/1680x1050_stretched_res.bat",
          "destination": "%USERPROFILE%\\scripts\\1680x1050_stretched_res.bat",
          "merge": false
        },
        {
          "id": "script-4-3",
          "source": "UserProfile/scripts/4.3_stretched_res.bat",
          "destination": "%USERPROFILE%\\scripts\\4.3_stretched_res.bat",
          "merge": false
        },
        {
          "id": "script-menu",
          "source": "UserProfile/scripts/menu.bat",
          "destination": "%USERPROFILE%\\scripts\\menu.bat",
          "merge": true
        },
        {
          "id": "script-open-with-micro",
          "source": "UserProfile/scripts/open_with_micro.bat",
          "destination": "%USERPROFILE%\\scripts\\open_with_micro.bat",
          "merge": true
        }
      ]
    }
  ],
  "migrations": [
    {
      "id": "remove-legacy-yazi-clipboard",
      "component": "yazi",
      "path": "%APPDATA%\\yazi\\config\\plugins\\clipboard.yazi",
      "type": "git-remote-directory",
      "expectedRemoteFragment": "XYenon/clipboard.yazi"
    }
  ],
